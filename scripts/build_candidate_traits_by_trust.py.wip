"""
build_candidate_traits_by_trust.py — §16 supporting evidence.

For each cycle 2016 / 2020 / 2024, compute the mean rating of each major-party
candidate on two traits ("cares about people like you" and "honest") by voter
institutional-trust band (low / mid / high terciles on the cycle's full
electorate).

The "cares about people like you" trait is the most direct measure of perceived
anti-elitism / anti-establishment positioning (per the technical doc, it's the
strongest proximate vote predictor and absorbs the trust signal).

Cross-validation: 2016 honesty numbers should match the published table in
the-center-is-a-lie.md §6 (Clinton low-trust ≈ 0.54, Trump low-trust ≈ 1.58
on the 0-4 scale).

Supports: plain-language.md §16 (supporting evidence for the body's
exit-poll establishment-classification finding).
"""
import numpy as np
import pandas as pd

from _lib import clean_var, load_anes_2016, load_anes_2020, load_anes_2024, write_clean


def to_0_4(s: pd.Series) -> pd.Series:
    """Convert ANES 1-5 Likert (1=extremely well, 5=not well at all) to 0-4 with HIGH=BETTER."""
    s = pd.to_numeric(s, errors="coerce")
    s = s.where(s.between(1, 5))
    return 5 - s


def weighted_mean(s: pd.Series, w: pd.Series) -> float:
    s = s.dropna()
    if len(s) == 0:
        return float("nan")
    w = w.loc[s.index]
    return float(np.average(s, weights=w))


def trust_tercile(trust: pd.Series, w: pd.Series) -> pd.Series:
    """Return 'low', 'mid', 'high' based on weighted terciles of the trust composite."""
    valid = trust.dropna()
    if len(valid) < 30:
        return pd.Series(["nan"] * len(trust), index=trust.index)
    order = valid.argsort()
    sorted_t = valid.iloc[order]
    sorted_w = w.loc[sorted_t.index]
    cw = np.cumsum(sorted_w.values)
    tot = cw[-1]
    cut1 = sorted_t.iloc[np.searchsorted(cw, tot / 3)]
    cut2 = sorted_t.iloc[np.searchsorted(cw, 2 * tot / 3)]
    out = pd.Series("mid", index=trust.index, dtype=object)
    out[trust <= cut1] = "low"
    out[trust >= cut2] = "high"
    out[trust.isna()] = "nan"
    return out


# ── 2016 ────────────────────────────────────────────────────────────────────
def cycle_2016():
    d = load_anes_2016()
    w = clean_var(d, "V160101", 0, 1e9).fillna(0).clip(lower=0)

    # Trust composite from §7 [1] — V161215, V161216, V161217
    t1 = clean_var(d, "V161215", 1, 5)  # gov is run by a few big interests
    t2 = clean_var(d, "V161216", 1, 5)  # gov wastes tax money
    t3 = clean_var(d, "V161217", 1, 5)  # how often gov can be trusted
    # Each item: HIGH value typically = LESS trust → reverse so HIGH=TRUST
    # But conventions vary; we follow the §7 build pattern.
    def norm_rev(s, lo=1, hi=5):
        return 1 - ((s - lo) / (hi - lo))
    trust = pd.concat([norm_rev(t1), norm_rev(t2), norm_rev(t3)], axis=1).mean(axis=1)

    # Candidate trait items (standard ANES 2016 pre-election battery):
    # V161159-V161163: Clinton (strong leader, cares, knowledgeable, honest, speaks mind)
    # V161164-V161168: Trump
    dem_cares = to_0_4(d["V161160"])
    dem_honest = to_0_4(d["V161162"])
    rep_cares = to_0_4(d["V161165"])
    rep_honest = to_0_4(d["V161167"])

    band = trust_tercile(trust, w)
    out = []
    for b in ["low", "mid", "high"]:
        m = (band == b) & (w > 0)
        out.append({
            "cycle": 2016, "dem": "Clinton", "rep": "Trump", "trust_band": b,
            "n_unweighted": int(m.sum()),
            "dem_cares_0to4": round(weighted_mean(dem_cares[m], w[m]), 2),
            "rep_cares_0to4": round(weighted_mean(rep_cares[m], w[m]), 2),
            "dem_honest_0to4": round(weighted_mean(dem_honest[m], w[m]), 2),
            "rep_honest_0to4": round(weighted_mean(rep_honest[m], w[m]), 2),
        })
    return out


# ── 2020 ────────────────────────────────────────────────────────────────────
def cycle_2020():
    d = load_anes_2020()
    w = pd.to_numeric(d["V200010a"], errors="coerce").fillna(0).clip(lower=0)

    # 2020 trust composite candidates: V201233 (most people can be trusted?), V201234, V201235
    # Better: use the 2-item efficacy as proxy (V201228, V201229) -- but better still, V201233-V201235
    # ANES 2020 government-trust item: V201233 (how often trust gov, 1-5 / 1-4)
    # Use V201233 alone as a quick trust proxy
    t1 = pd.to_numeric(d["V201233"], errors="coerce")
    t1 = t1.where(t1.between(1, 5))
    # 1=just about always (HIGH trust) ... 5=never (LOW trust) → reverse
    trust = 1 - ((t1 - 1) / 4)

    # Standard 2020 trait battery: V201236-V201239 (Trump), V201240-V201243 (Biden)
    # Or reverse — need to confirm by checking which gives lower "honest" ratings for Trump
    # Standard codebook order: incumbent first → V201236+ = Trump, V201240+ = Biden
    rep_strong = to_0_4(d["V201236"])
    rep_cares = to_0_4(d["V201237"])
    rep_know = to_0_4(d["V201238"])
    rep_honest = to_0_4(d["V201239"])
    dem_strong = to_0_4(d["V201240"])
    dem_cares = to_0_4(d["V201241"])
    dem_know = to_0_4(d["V201242"])
    dem_honest = to_0_4(d["V201243"])

    band = trust_tercile(trust, w)
    out = []
    for b in ["low", "mid", "high"]:
        m = (band == b) & (w > 0)
        out.append({
            "cycle": 2020, "dem": "Biden", "rep": "Trump", "trust_band": b,
            "n_unweighted": int(m.sum()),
            "dem_cares_0to4": round(weighted_mean(dem_cares[m], w[m]), 2),
            "rep_cares_0to4": round(weighted_mean(rep_cares[m], w[m]), 2),
            "dem_honest_0to4": round(weighted_mean(dem_honest[m], w[m]), 2),
            "rep_honest_0to4": round(weighted_mean(rep_honest[m], w[m]), 2),
        })
    return out


# ── 2024 ────────────────────────────────────────────────────────────────────
def cycle_2024():
    d = load_anes_2024()
    # Weight: ANES 2024 typically V240107a or V240108a
    w_col = "V240107a" if "V240107a" in d.columns else ("V240108a" if "V240108a" in d.columns else None)
    if w_col is None:
        # Fall back to a likely weight column
        w = pd.Series(1.0, index=d.index)
    else:
        w = pd.to_numeric(d[w_col], errors="coerce").fillna(0).clip(lower=0)

    # 2024 trust item: V241228 or similar (need to identify)
    # ANES 2024 typically has V241226 / V241227 for trust items
    # Try V241226 as the "how often trust gov" item
    t_col = None
    for cand in ["V241228", "V241226", "V241227", "V241230"]:
        if cand in d.columns:
            x = pd.to_numeric(d[cand], errors="coerce")
            if x.between(1, 5).sum() > 1000:
                t_col = cand
                break
    if t_col is None:
        raise RuntimeError("Could not find a trust item for 2024")
    t1 = pd.to_numeric(d[t_col], errors="coerce").where(lambda s: s.between(1, 5))
    trust = 1 - ((t1 - 1) / 4)

    # 2024 trait battery candidates: V241200-V241205 (6 items = 3 traits × 2 candidates?)
    # OR V241200-V241207 (4 traits × 2 candidates)
    # Standard order: incumbent first (Biden) then challenger (Trump) — but in 2024 Harris not Biden
    # Try V241200-V241202 (Harris) and V241203-V241205 (Trump) — 3 traits each
    # Likely: strong leader / cares / honest
    dem_strong = to_0_4(d["V241200"])
    dem_cares = to_0_4(d["V241201"])
    dem_honest = to_0_4(d["V241202"])
    rep_strong = to_0_4(d["V241203"])
    rep_cares = to_0_4(d["V241204"])
    rep_honest = to_0_4(d["V241205"])

    band = trust_tercile(trust, w)
    out = []
    for b in ["low", "mid", "high"]:
        m = (band == b) & (w > 0)
        out.append({
            "cycle": 2024, "dem": "Harris", "rep": "Trump", "trust_band": b,
            "n_unweighted": int(m.sum()),
            "dem_cares_0to4": round(weighted_mean(dem_cares[m], w[m]), 2),
            "rep_cares_0to4": round(weighted_mean(rep_cares[m], w[m]), 2),
            "dem_honest_0to4": round(weighted_mean(dem_honest[m], w[m]), 2),
            "rep_honest_0to4": round(weighted_mean(rep_honest[m], w[m]), 2),
        })
    return out


def main():
    rows = cycle_2016() + cycle_2020() + cycle_2024()

    # Cross-validation: 2016 honesty target from technical doc §6:
    # low-trust: Clinton 0.54 / Trump 1.58; high-trust: Clinton 1.77 / Trump 0.93
    print("Cross-check vs technical doc §6 (target: 2016 low-trust Clinton 0.54 / Trump 1.58):")
    for r in rows:
        if r["cycle"] == 2016:
            print(f"  {r['trust_band']}: Clinton honest={r['dem_honest_0to4']}, Trump honest={r['rep_honest_0to4']}")
    print()

    write_clean(
        name="candidate_traits_by_trust",
        rows=rows,
        manifest={
            "source": "ANES 2016 DTA + ANES 2020 CSV + ANES 2024 CSV.",
            "variables": [
                "2016: V160101 (weight), V161215+V161216+V161217 (trust composite), "
                "V161159–V161163 (Clinton traits), V161164–V161168 (Trump traits)",
                "2020: V200010a (weight), V201233 (trust), V201236–V201239 (Trump traits), "
                "V201240–V201243 (Biden traits)",
                "2024: V240107a (weight), V241226 or similar (trust), V241200–V241202 (Harris traits), "
                "V241203–V241205 (Trump traits)",
            ],
            "filter": "Full sample per cycle; trust terciles cut weighted on full electorate.",
            "weight": "Cycle-specific post-election weight",
            "method": "Trait ratings on the ANES 1-5 Likert (1=extremely well, 5=not well at all) "
                      "rescaled to 0-4 with HIGH=BETTER. Trust composite from cycle's available items, "
                      "rescaled so HIGH=MORE trust. Tercile cuts on the full electorate. "
                      "Weighted means per trust band per candidate per trait.",
            "n": int(sum(r["n_unweighted"] for r in rows)),
            "supports": ["plain-language.md §16 (cross-cycle establishment classification)",
                         "the-center-is-a-lie.md §6 (authenticity crossover)"],
            "caveats": [
                "2016 honesty numbers reproduce technical doc §6 if variable mapping is correct.",
                "2020 candidate ordering (Trump first or Biden first) inferred from typical codebook order; "
                "verify by checking 2020 high-trust Biden honest > Trump honest (should hold).",
                "2024 codebook order similarly inferred; verify by checking high-trust Harris honest > Trump.",
                "Trust composites vary across cycles (different items available); cross-cycle level comparisons "
                "should be interpreted cautiously; the WITHIN-cycle perception gaps are what's load-bearing.",
                "ANES under-samples the truly disengaged; the 'low-trust' band may understate the alienated tail.",
            ],
        },
    )


if __name__ == "__main__":
    main()
